{
  "name": "codein/recaptcha-enterprise-bundle",
  "description": "Symfony integration for Google reCAPTCHA Enterprise (Assessments API). Fork of artack/recaptcha-enterprise-bundle.",
  "type": "symfony-bundle",
  "license": "MIT",
  "keywords": ["symfony", "bundle", "recaptcha", "recaptcha-enterprise", "captcha", "form", "spam"],
  "authors": [
    {
      "name": "Codein-Labs",
      "email": "labs@codein.fr",
      "homepage": "https://www.codein.fr"
    },
    {
      "name": "Marc Teinturier",
      "role": "Maintainer",
      "email": "marc.teinturier@codein.fr"
    },
    {
      "name": "Louise Soulier",
      "role": "Contributor",
      "email": "louise.soulier@codein.fr"
    },
    {
      "name": "ARTACK WebLab GmbH",
      "homepage": "https://www.artack.ch",
      "role": "Original author of artack/recaptcha-enterprise-bundle"
    }
  ],
  "support": {
    "issues": "https://github.com/Codein-Labs/recaptcha-enterprise-bundle/issues",
    "source": "https://github.com/Codein-Labs/recaptcha-enterprise-bundle"
  },
  "require": {
    "php": "^8.1",
    "symfony/form": "^5.4 || ^6.4 || ^7.4 || ^8.0",
    "symfony/framework-bundle": "^5.4 || ^6.4 || ^7.4 || ^8.0",
    "symfony/http-client": "^5.4 || ^6.4 || ^7.4 || ^8.0",
    "symfony/http-foundation": "^5.4 || ^6.4 || ^7.4 || ^8.0",
    "symfony/validator": "^5.4 || ^6.4 || ^7.4 || ^8.0",
    "twig/twig": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0",
    "roave/security-advisories": "dev-latest",
    "symfony/twig-bridge": "^5.4 || ^6.4 || ^7.4 || ^8.0"
  },
  "autoload": {
    "psr-4": {
      "Codein\\RecaptchaEnterpriseBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Codein\\RecaptchaEnterpriseBundle\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "update:tools": "composer update -d tools/php-cs-fixer && composer update -d tools/phpstan",
    "phpcs": "tools/php-cs-fixer/vendor/bin/php-cs-fixer fix -vvv --diff --dry-run --allow-risky=yes --ansi",
    "phpcs:fix": "tools/php-cs-fixer/vendor/bin/php-cs-fixer fix -vvv --allow-risky=yes --ansi",
    "phpstan": "tools/phpstan/vendor/bin/phpstan analyse -c phpstan.neon --ansi",
    "phpunit": "vendor/bin/phpunit --colors=always",
    "test": [
      "@phpstan",
      "@phpcs",
      "@phpunit"
    ]
  }
}
