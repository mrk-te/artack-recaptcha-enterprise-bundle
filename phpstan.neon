parameters:
  level: 9

  paths:
    - src
    - tests

  # The analysed sources must hold for every supported PHP version, whatever the runtime is.
  phpVersion:
    min: 80100
    max: 80400

  # The bundle supports Symfony 5.4 up to 8.x, whose stubs differ; an ignore that matches on one
  # version does not necessarily match on another.
  reportUnmatchedIgnoredErrors: false

  # Because of the setting above these two never report themselves as obsolete: re-check them by
  # hand whenever the supported Symfony floor moves.
  ignoreErrors:
    # phpstan-symfony declares NodeBuilder as a generic class, which it is not.
    - identifier: class.notFound
      path: src/DependencyInjection/Configuration.php
    # ConstraintValidatorTestCase only became generic after Symfony 5.4.
    - identifier: missingType.generics
      path: tests/Validator/RecaptchaEnterpriseValidatorTest.php
