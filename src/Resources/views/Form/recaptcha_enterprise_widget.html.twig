{#
    The theme emits no JavaScript at all. Every field is described by data attributes, and the
    behaviour lives in the shipped asset, which the application loads once:

        <script src="{{ asset('bundles/codeinrecaptchaenterprise/recaptcha-enterprise.js') }}" defer></script>

    Two challenges, two blocks, so an application can override one without touching the other. They
    are not interchangeable: each needs its own kind of site key in the Google console.
#}
{#
    The field inherits from HiddenType, whose hidden_row block renders the widget alone — so without
    this the violation is raised, attached to the field, and never shown. Errors do not bubble to
    the parent form either, since error_bubbling defaults to false on a non-compound field.
#}
{% block recaptcha_enterprise_row %}
    {{- form_errors(form) -}}
    {{- form_widget(form) -}}
{% endblock %}

{% block recaptcha_enterprise_widget %}
    {%- if form.vars.challenge == 'checkbox' -%}
        {{- block('recaptcha_enterprise_checkbox_widget') -}}
    {%- else -%}
        {{- block('recaptcha_enterprise_score_widget') -}}
    {%- endif -%}
{% endblock %}

{% block recaptcha_enterprise_score_widget %}
    {%- set type = type|default('hidden') -%}
    {#- A re-rendered form must never carry the previous token back. Google refuses a replayed token
        with DUPE, so the field would fail validation on every further attempt. -#}
    {%- set value = '' -%}
    {#- The attributes the asset discovers the field by. A disabled bundle emits none of them, which
        leaves an inert hidden field the asset ignores. -#}
    {%- if form.vars.enabled -%}
        {%- set attr = attr|merge({
            'data-codein-recaptcha': form.vars.challenge,
            'data-codein-recaptcha-sitekey': form.vars.site_key,
        }) -%}
        {%- if form.vars.action_name -%}
            {%- set attr = attr|merge({'data-codein-recaptcha-action': form.vars.action_name}) -%}
        {%- endif -%}
    {%- endif -%}
    {{ block('form_widget_simple') }}

    {%- if form.vars.enabled %}
        <noscript>{{ 'This form requires JavaScript.'|trans({}, 'validators') }}</noscript>
    {%- endif %}
{% endblock %}

{% block recaptcha_enterprise_checkbox_widget %}
    {%- set type = type|default('hidden') -%}
    {#- The Google widget resets when the form is re-rendered, so a value kept here would be a spent
        token submitted by a user who did not tick the box again. -#}
    {%- set value = '' -%}
    {#- The attributes the asset discovers the field by. A disabled bundle emits none of them, which
        leaves an inert hidden field the asset ignores. -#}
    {%- if form.vars.enabled -%}
        {%- set attr = attr|merge({
            'data-codein-recaptcha': form.vars.challenge,
            'data-codein-recaptcha-sitekey': form.vars.site_key,
        }) -%}
        {%- if form.vars.action_name -%}
            {%- set attr = attr|merge({'data-codein-recaptcha-action': form.vars.action_name}) -%}
        {%- endif -%}
    {%- endif -%}
    {{ block('form_widget_simple') }}

    {%- if form.vars.enabled %}
        <div class="recaptcha-enterprise__widget"
             data-codein-recaptcha-container="{{ form.vars.id }}"
             data-codein-recaptcha-theme="{{ form.vars.theme }}"
             data-codein-recaptcha-size="{{ form.vars.size }}"></div>
        <noscript>{{ 'This form requires JavaScript.'|trans({}, 'validators') }}</noscript>
    {%- endif %}
{% endblock %}
